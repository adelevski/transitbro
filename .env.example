# Private server-side CTA Train Tracker credential. Never use NEXT_PUBLIC_.
CTA_API_KEY=your_cta_train_tracker_api_key

# Optional polling guidance; effective lower bound is 20 seconds.
CTA_POLL_INTERVAL_MS=20000

